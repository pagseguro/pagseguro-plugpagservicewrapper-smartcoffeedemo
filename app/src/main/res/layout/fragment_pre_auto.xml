<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvPreAuto"
        android:layout_width="@dimen/payment_popup_width"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/title_margin"
        android:background="@drawable/btn_rounded"
        android:gravity="center"
        android:minHeight="100dp"
        android:paddingHorizontal="@dimen/title_margin"
        android:text="@string/waiting"
        android:textColor="@color/black"
        android:textSize="@dimen/option_size"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/lnPreAuto"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/title_margin"
        android:layout_marginBottom="@dimen/keyboard_button_margin"
        android:background="@color/black"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPreAuto" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clButtons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lnPreAuto">

        <Button
            android:id="@+id/btnConsulting"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/keyboard_button_margin"
            android:layout_weight="1"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#000000"
            android:minHeight="@dimen/option_line"
            android:text="@string/consulting"
            android:textSize="@dimen/option_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnConsultingKeyed"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/keyboard_button_margin"
            android:layout_weight="1"
            android:background="@drawable/btn_rounded"
            android:backgroundTint="#000000"
            android:minHeight="@dimen/option_line"
            android:text="@string/consulting_keyed"
            android:textSize="@dimen/option_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnConsulting" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clPreAutoItems"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPreAuto">

        <View
            android:id="@+id/bgPreAutoItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/over" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rclPreAutoItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toTopOf="@id/btnClose"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:listitem="@layout/fragment_preauto_item" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/keyboard_button_margin"
            android:layout_weight="1"
            android:background="@drawable/btn_rounded"
            android:minHeight="@dimen/option_line"
            android:text="Fechar"
            android:textSize="@dimen/option_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/ilLoading"
        layout="@layout/content_view_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lnPreAuto" />

    <include
        android:id="@+id/ilCardData"
        layout="@layout/content_preauto_keyed"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
